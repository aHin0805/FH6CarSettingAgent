# ========= 轻量模型（日常对话、简单问答） =========
AI_API_KEY=your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ========= 深度模型（调校生成、方案对比、复杂诊断） =========
AI_DEEP_API_KEY=            # 留空则复用 AI_API_KEY
AI_DEEP_BASE_URL=           # 留空则复用 AI_BASE_URL
AI_DEEP_MODEL=deepseek-v4-pro
AI_DEEP_TEMPERATURE=0.3
AI_DEEP_MAX_TOKENS=8192

# ========= 服务配置 =========
PORT=3001
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
